<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only. Drives a singleplayer run through four levels, checks the floors and rides the lift.
       Never shipped. Only wakes up when BepInEx/config/elevators-probe.flag exists in the profile. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>ElevatorsProbe</RootNamespace>
    <AssemblyName>ElevatorsProbe</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <UserHome Condition="'$(UserHome)' == '' and '$(HOME)' != ''">$(HOME)</UserHome>
    <GalePluginsDir Condition="'$(GalePluginsDir)' == ''">$(UserHome)/.local/share/com.kesomannen.gale/repo/profiles/Developer/BepInEx/plugins</GalePluginsDir>
    <OutputPath>$(GalePluginsDir)/ElevatorsProbe/</OutputPath>
    <RepoManagedDir Condition="'$(RepoManagedDir)' == '' and Exists('$(UserHome)/.local/share/Steam/steamapps/common/REPO/REPO_Data/Managed')">$(UserHome)/.local/share/Steam/steamapps/common/REPO/REPO_Data/Managed</RepoManagedDir>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.3.17" IncludeAssets="compile" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RepoManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(RepoManagedDir)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RepoManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(RepoManagedDir)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonUnityNetworking"><HintPath>$(RepoManagedDir)/PhotonUnityNetworking.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonRealtime"><HintPath>$(RepoManagedDir)/PhotonRealtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Photon3Unity3D"><HintPath>$(RepoManagedDir)/Photon3Unity3D.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Elevators"><HintPath>$(GalePluginsDir)/Elevators/Elevators.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
